{
  "mcpServers": {
    "gitlab": {
      "command": "npx",
      "args": ["-y", "@wanadev/mcp-gitlab@latest"],
      "env": {
        "GITLAB_TOKEN": "${GITLAB_TOKEN:-}",
        "GITLAB_BASE_URL": "${GITLAB_BASE_URL:-https://gitlab.com}",
        "GITLAB_READ_ONLY": "${GITLAB_READ_ONLY:-false}"
      }
    }
  }
}
